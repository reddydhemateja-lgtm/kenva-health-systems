# ========================================================
# KENVA HEALTH SYSTEMS — LOCAL SMTP CONFIGURATION TEMPLATE
# ========================================================
# Copy this file to .env in the backend folder:
#   copy .env.example .env

PORT=5000
JWT_SECRET=kenva_production_jwt_secret_token_key_9921_x

# --------------------------------------------------------
# OPTION 1: GMAIL (Recommended for Real Emails to your Inbox)
# --------------------------------------------------------
# 1. Turn ON 2-Step Verification on your Google Account:
#    https://myaccount.google.com/security
# 2. Generate an "App Password" (select app: Other, name: "Kenva"):
#    https://myaccount.google.com/apppasswords
# 3. Google gives you a 16-character code (e.g., "abcd efgh ijkl mnop")
# 4. Fill below:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=abcdefghijklmnop
# FROM_EMAIL=your_email@gmail.com

# --------------------------------------------------------
# OPTION 2: MAILTRAP (Best for Safe Local Testing)
# --------------------------------------------------------
# Mailtrap catches all outgoing emails in a web sandbox so you can inspect
# beautiful HTML templates without spamming real email accounts.
# Free signup: https://mailtrap.io -> Inboxes -> SMTP Settings -> Integrations -> Nodemailer
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your_mailtrap_username
# SMTP_PASS=your_mailtrap_password
# FROM_EMAIL=notifications@kenva.local

# --------------------------------------------------------
# OPTION 3: BREVO (Formerly Sendinblue) / CUSTOM SMTP
# --------------------------------------------------------
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_brevo_login
# SMTP_PASS=your_brevo_smtp_key
# FROM_EMAIL=no-reply@yourdomain.com
